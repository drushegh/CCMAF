{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-.}\" && { [ -f .claude/.framework-version ] && ! grep -Eq \"^[[:space:]]*FRAMEWORK_LINE=v2\" .claude/.framework-version || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/console-autostart.sh\"; }'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-.}\" && { [ -f .claude/.framework-version ] && ! grep -Eq \"^[[:space:]]*FRAMEWORK_LINE=v2\" .claude/.framework-version || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/console-heartbeat.sh\"; }'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-.}\" && { [ -f .claude/.framework-version ] && ! grep -Eq \"^[[:space:]]*FRAMEWORK_LINE=v2\" .claude/.framework-version || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/console-heartbeat.sh\"; }'"
          }
        ]
      }
    ]
  }
}
