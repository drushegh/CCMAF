{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-.}\" && { [ -f .claude/.framework-version ] && ! grep -Eq \"^[[:space:]]*FRAMEWORK_LINE=v2\" .claude/.framework-version && [ \"${CCMAF_DEVHOOKS_FORCE:-0}\" != 1 ] || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/filter-test-output.sh\"; }'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-.}\" && { [ -f .claude/.framework-version ] && ! grep -Eq \"^[[:space:]]*FRAMEWORK_LINE=v2\" .claude/.framework-version && [ \"${CCMAF_DEVHOOKS_FORCE:-0}\" != 1 ] || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-edit-dispatch.sh\"; }'"
          }
        ]
      }
    ]
  }
}
