{
  "name": "ccmaf-console",
  "version": "0.2.0",
  "description": "CCMAF Project Console — local dashboard, verify queue and machine Hub for CCMAF projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drushegh/CCMAF.git",
    "directory": "console"
  },
  "type": "module",
  "bin": {
    "ccmaf-console": "bin/ccmaf-console.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-server/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node dist-server/main.js",
    "build": "tsc -p tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "serve": "node dist-server/main.js",
    "console": "node dist-server/hub/launcher.js",
    "hub": "node dist-server/hub/hub-main.js",
    "start": "npm run build:server && npm run serve",
    "preview": "vite preview",
    "prepack": "npm run build && npm run build:server",
    "smoke-pack": "node scripts/smoke-pack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "fastify": "^5.9.0",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.511.0",
    "markdown-it": "^14.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
